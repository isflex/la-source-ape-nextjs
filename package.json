{
  "name": "@flexiness/la_source_ape",
  "version": "1.0.0",
  "private": true,
  "description": "La Source | APE | FullStack NextJS App",
  "repository": "git@github.com:isflex/la-source-ape-nextjs",
  "license": "MIT",
  "author": "ischerer <hello@flexiness.com>",
  "type": "module",
  "scripts": {
    "agent:dev": "cd agent && dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- ./run.sh",
    "agent:install": "cd agent && dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- uv sync",
    "ai:claude": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- claude --permission-mode auto --chrome --settings .claude/settings.json",
    "ai:claude:debug": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- claude --debug --chrome --settings .claude/settings.json",
    "ampx:sandbox": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- ./bin/ampx-sandbox.sh",
    "build": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- ./bin/run-build-client.sh",
    "compile": "pnpm compile:clean:sh",
    "compile:clean:sh": "./bin/run-compile.sh clean",
    "compile:sh": "./bin/run-compile.sh",
    "compile:tsc:project:references": "pnpm tsc -b ./tsconfig.build.json",
    "compile:tsc:project:references:watch": "pnpm tsc -b ./tsconfig.build.watch.json --watch --preserveWatchOutput",
    "compile:watch": "turbo run compile:watch:sh",
    "compile:watch:sh": "./bin/run-compile-watch.sh",
    "dev": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- turbo run dev",
    "dev:all": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- turbo run dev:all",
    "dev:turbo": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- turbo run dev:turbo",
    "install:dev": "./bin/pnpm-install.sh",
    "install:prod": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- ./bin/run-install-prod.sh",
    "kill:all:ports": "pnpm kill-port --port 3001,8061; fuser -k 3001/tcp 8061/tcp 2>/dev/null || true",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run lint --continue --concurrency 1",
    "listen:stripe": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- stripe listen --forward-to $FLEX_GATEWAY_HOST/api/cagnotte/webhook",
    "prepare": "node .husky/install.mjs",
    "reset:compile": "./bin/run-reset-compile.sh",
    "seed": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- turbo run seed",
    "start": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- turbo run start",
    "test": "echo \"¯\\_(ツ)_/¯ Will test another day !!\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.44.0",
    "@flex-design-system/framework": "workspace:*",
    "@flex-design-system/react-ts": "workspace:*",
    "@flexiness/copilotkit": "workspace:*",
    "@flexiness/domain-store": "workspace:*",
    "@flexiness/domain-tailwind": "workspace:*",
    "@flexiness/domain-utils": "workspace:*",
    "aws-amplify": "^6.16.3",
    "classnames": "^2.5.1",
    "isomorphic-dompurify": "^2.33.0",
    "kill-port": "2.0.1",
    "mobx": "6.13.7",

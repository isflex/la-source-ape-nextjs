    "next": "16.2.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.6.1",
    "regex-escape": "3.4.10",
    "tslib": "^2.8.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@flexiness/eslint-config-flat": "workspace:*",
    "@flexiness/tsconfig": "workspace:*",
    "@flexiness/webpack": "workspace:*",
    "@rspack/cli": "^1.6.6",
    "@rspack/core": "^1.6.6",
    "@types/ejs": "3.1.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "cross-env": "7.0.3",
    "css-loader": "7.1.4",

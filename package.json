    "mini-css-extract-plugin": "2.10.2",
    "node-polyfill-webpack-plugin": "3.0.0",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-loader": "8.1.1",
    "postcss-preset-env": "10.1.3",
    "postcss-scss": "4.0.9",
    "postcss-strip-inline-comments": "0.1.5",
    "prettier": "3.4.2",
    "rimraf": "6.1.0",
    "sass-embedded": "^1.100.0",
    "sass-loader": "17.0.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tsup": "^8.5.1",
    "turbo": "2.9.12",
    "typed-scss-modules": "workspace:@flexiness/typed-scss-modules@*",
    "typescript": "5.9.3",
    "webpack": "5.105.4"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "pnpm": {
    "overrides": {
      "flexiness": "workspace:./packages/flex/types",
      "@flexiness/eslint-config-flat": "workspace:./packages/flex/config/eslint/flat-config",
      "@flexiness/tsconfig": "workspace:./packages/flex/config/tsconfig",
      "gateway": "workspace:./apps/gateway",
      "@flexiness/webpack": "workspace:./packages/flex/config/webpack",
      "@flexiness/copilotkit": "workspace:./packages/flex/copilotkit",
      "@flexiness/domain-utils": "workspace:./packages/flex/domain-utils",
      "@flexiness/domain-store": "workspace:./packages/flex/domain-store",
      "@flexiness/domain-tailwind": "workspace:./packages/flex/domain-tailwind",
      "@flex-design-system/framework": "workspace:./packages/flex/design-system-framework",
      "@flex-design-system/react-ts": "workspace:./packages/flex/design-system-react-ts",
      "typed-scss-modules": "workspace:./packages/flex/config/typed-scss-modules",
      "aws-amplify": "^6.17.0",
      "@aws-amplify/core": "6.16.3",
      "@aws-amplify/plugin-types": "1.12.0",
      "glob": "13.0.6",
      "node-fetch": "^3.3.2",
      "next": "16.2.4",
      "react": "19.2.1",

      "react-router": "7.6.1",
      "react-hook-form": "7.66.0",
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3",
      "eslint": "9.39.1",
      "typescript-eslint": "^8.48.0",
      "browserslist": "4.27.0",
      "minimatch": "10.1.1",
      "rimraf": "6.1.0",
      "tslib": "^2.8.1",
      "tsup": "^8.5.1",
      "esbuild": "0.27.0",
      "@aws-sdk/client-s3": "3.932.0",
      "@aws-sdk/client-sts": "3.699.0",
      "@aws-sdk/client-sso-oidc": "3.699.0",
      "webpack": "5.105.4",
      "vue-tsc": "^2.0.26",
      "@rspack/cli": "^1.6.6",
      "@rspack/core": "^1.6.6",
      "sass-embedded": "^1.100.0",
      "@jridgewell/gen-mapping": "0.3.8",
      "rxjs": "7.8.1",
      "openai": "^6.16.0",
      "graphql": "^16.12.0",
      "zod": "4.3.5",
      "@ag-ui/client": "0.0.53",

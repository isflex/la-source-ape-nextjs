{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "amplify:sandbox:create": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- pnpm ampx sandbox --once --profile $AWS_PROFILE --identifier $FLEX_AWS_AMPLIFY_IDENTIFIER",
    "amplify:sandbox:delete": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- pnpm ampx sandbox delete --profile $AWS_PROFILE --identifier $FLEX_AWS_AMPLIFY_IDENTIFIER",
    "amplify:sandbox:watch": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- pnpm ampx sandbox --profile $AWS_PROFILE --identifier $FLEX_AWS_AMPLIFY_IDENTIFIER",
    "amplify:secrets:list": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- pnpm ampx sandbox secret list --profile $AWS_PROFILE --identifier $FLEX_AWS_AMPLIFY_IDENTIFIER",
    "analyze": "ANALYZE=true pnpm build",
    "prebuild": "pnpm copy:wasm",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- $FLEX_PROJ_ROOT/bin/run-build-gateway.sh",
    "copy:wasm": "bash $FLEX_PROJ_ROOT/bin/run-copy-asset.sh @lottiefiles/dotlottie-web/dist/dotlottie-player.wasm:public/animations/lottie/dotlottie-player.wasm",
    "cypress:open": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- cypress open",
    "cypress:run": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- cypress run",
    "cypress:run:component": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- cypress run --component",
    "cypress:run:e2e": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- cypress run --e2e",
    "predev": "pnpm copy:wasm",
    "dev": "cross-env FLEX_STRIPE_WEBHOOK_SECRET=$(stripe listen --print-secret) && echo 'Gateway dev server is managed by Turbo (next:dev task)'",
    "lint": "pnpm lint:flat",
    "lint:flat": "cross-env NODE_OPTIONS='--max-old-space-size=8192' ESLINT_USE_FLAT_CONFIG=true pnpm eslint \"./src/**/*.{ts,tsx}\"",
    "marp:build": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- pnpm marp:html:build",
    "marp:dev": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- pnpm marp:html:dev",
    "marp:dev:server": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- marp --server --config ./marp.config.mjs",
    "marp:html:build": "cross-env BUILD_RUNNING=true marp --config ./marp.config.mjs",
    "marp:html:dev": "cross-env BUILD_RUNNING=false marp --config ./marp.config.mjs",
    "prenext:dev": "pnpm copy:wasm",
    "next:dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- next dev --webpack ./ --port $FLEX_GATEWAY_PORT --hostname $FLEX_GATEWAY_HOSTNAME",
    "next:dev:all": "cross-env NODE_OPTIONS='--max-old-space-size=8192' dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- next dev --webpack ./ --port $FLEX_GATEWAY_PORT --hostname $FLEX_GATEWAY_HOSTNAME",
    "next:dev:turbo": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- $FLEX_PROJ_ROOT/bin/next-turbo-dev.sh",
    "next:tsc": "pnpm exec tsc --project tsconfig.json --noEmit",
    "setup:admin": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- $FLEX_PROJ_ROOT/bin/setup-dev-admin.sh",
    "start": "cross-env NODE_OPTIONS='--max-old-space-size=8192' dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- $FLEX_PROJ_ROOT/bin/run-start-gateway.sh",
    "test": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- cypress run",
    "test:e2e": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- cypress run --e2e",
    "test:open": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- cypress open",
    "test:unit": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- cypress run --spec 'cypress/unit/**/*.cy.{js,ts}'",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "warm:api": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- $FLEX_PROJ_ROOT/bin/warm-api-routes.sh"
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "1.6.2",
    "@aws-amplify/ui-react": "^6.15.3",
    "@aws-sdk/client-cloudwatch-logs": "^3.953.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.927.0",
    "@aws-sdk/client-ec2": "3.844.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/client-secrets-manager": "^3.954.0",
    "@aws-sdk/credential-provider-cognito-identity": "^3.972.31",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@flex-design-system/framework": "workspace:*",
    "@flex-design-system/react-ts": "workspace:*",
    "@flexiness/copilotkit": "workspace:*",
    "@flexiness/domain-store": "workspace:*",
    "@flexiness/domain-tailwind": "workspace:*",
    "@flexiness/domain-utils": "workspace:*",
    "@hookform/resolvers": "5.2.2",
    "@loadable/component": "5.13.2",
    "@lottiefiles/dotlottie-react": "0.17.4",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@module-federation/enhanced": "0.21.6",
    "@mui/material": "^9.0.1",
    "@next/mdx": "16.0.1",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.5.3",
    "aws-jwt-verify": "^4.0.1",
    "cors": "2.8.5",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "debounce": "2.2.0",
    "escape-string-regexp": "5.0.0",
    "framer-motion": "12.23.12",
    "libphonenumber-js": "1.12.23",
    "lodash-es": "4.17.22",
    "material-ui-confirm": "4.0.0",
    "next": "16.2.4",
    "next-mdx-remote-client": "2.1.7",
    "next-recompose-plugins": "3.0.0",
    "posthog-js": "^1.236.7",
    "posthog-node": "4.17.2",
    "react": "19.2.1",
    "react-datepicker": "8.8.0",
    "react-device-detect": "2.2.3",
    "react-dom": "19.2.1",
    "react-error-boundary": "6.0.0",
    "react-hook-form": "7.66.0",
    "react-intersection-observer": "10.0.0",
    "react-router": "7.6.1",
    "react-sticky-el": "2.1.1",
    "sanitize-html": "^2.17.4",
    "stripe": "^20.0.0",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.22.0",
    "@aws-amplify/backend-cli": "^1.8.2",
    "@aws-sdk/types": "^3.804.0",
    "@marp-team/marp-cli": "^4.1.1",
    "@next/bundle-analyzer": "^16.0.7",
    "@svgr/webpack": "8.1.0",
    "@types/cors": "2.8.17",
    "@types/loadable__component": "5.13.4",
    "@types/lodash-es": "4.17.12",
    "@types/mdx": "2.0.13",
    "@types/node": "25.6.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "9.0.3",
    "aws-cdk": "^2.1121.0",
    "aws-cdk-lib": "^2.253.1",
    "constructs": "^10.4.2",
    "cypress": "^15.6.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "14.1.4",
    "flexiness": "workspace:@types/flexiness@*",
    "sass-embedded": "^1.93.3",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4",
    "webpack": "5.103.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-sso-oidc": "*",
    "@aws-sdk/client-sts": "*",
    "graphql": "*"
  }
}

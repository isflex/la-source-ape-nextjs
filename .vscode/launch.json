{
  // ========================================
  // DEBUG CONFIGURATIONS
  // ========================================
  // Note: Primary launch configs are in flexi-gateway.code-workspace
  // This file provides fallback for non-workspace usage

  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_OPTIONS": "--inspect",
        "FLEX_PROJ_ROOT": "${workspaceFolder}",
        "FLEX_MODE": "development"
      }
    },
    {
      "name": "Next.js: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/gateway",
      "sourceMaps": true
    },
    {
      "name": "Debug Current TS File",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--loader", "ts-node/esm", "--no-warnings"],
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "FLEX_PROJ_ROOT": "${workspaceFolder}",
        "FLEX_MODE": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach to Node Process",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Next.js: debug full stack",
      "configurations": ["Next.js: debug server-side", "Next.js: debug client-side"]
    }
  ]
}

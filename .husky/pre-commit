#!/bin/sh
# Husky pre-commit hook for worktree linting and perhaps testing

echo "🔄 Pre-commit hook: Linting and perhaps testing..."

# Detect current worktree by checking the directory name
CURRENT_WORKTREE=$(basename "$(pwd)")

echo "📍 Current worktree: $CURRENT_WORKTREE"

# Execute appropriate sync script based on worktree
if [ "$CURRENT_WORKTREE" = "flexi" ]; then
  pnpm lint
  pnpm test

  #prettier $(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g') --write --ignore-unknown
  #git update-index --again
fi

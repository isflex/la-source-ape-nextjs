#!/bin/sh
# Husky post-commit hook for worktree synchronization

echo "🔄 Post-commit hook: Detecting worktree and syncing changes..."

# Detect current worktree by checking the directory name
CURRENT_WORKTREE=$(basename "$(pwd)")

echo "📍 Current worktree: $CURRENT_WORKTREE"

# Execute appropriate sync script based on worktree
if [ "$CURRENT_WORKTREE" = "apel" ]; then
    echo "🔄 Syncing changes from apel to flexi..."
    if [ -f "./bin/sync-apel-to-flexi.sh" ]; then
        ./bin/sync-apel-to-flexi.sh
    else
        echo "⚠️  Sync script not found: ./bin/sync-apel-to-flexi.sh"
    fi
elif [ "$CURRENT_WORKTREE" = "flexi" ]; then
    echo "🔄 Syncing changes from flexi to apel..."
    if [ -f "./bin/sync-flexi-to-apel.sh" ]; then
        ./bin/sync-flexi-to-apel.sh
    else
        echo "⚠️  Sync script not found: ./bin/sync-flexi-to-apel.sh"
    fi
else
    echo "ℹ️  Not in a known worktree ($CURRENT_WORKTREE), skipping sync"
fi

echo "✅ Post-commit hook completed"
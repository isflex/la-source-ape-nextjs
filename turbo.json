{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "FLEX_MODE",
    "FLEX_PROJ_ROOT",
    "FLEX_DOMAIN_NAME",
    "FLEX_POKER_CLIENT_BUILD_SYS",
    "FLEX_POKER_CLIENT_TARGET",
    "DOTENV_PRIVATE_KEY_DEVELOPMENT",
    "DOTENV_PRIVATE_KEY_PRODUCTION",
    "GIT_COMMIT_SHORT_SHA",
    "NEXT_PUBLIC_BUILD_ID",
    "BUILD_RUNNING",
    "HUSKY"
  ],
  "tasks": {
    "//#agent:dev": {
      "dependsOn": ["//#compile:transit"],
      "env": ["AWS_*", "DOTENV_*", "FLEX_*", "GIT_*", "NEXT_PUBLIC_*"],
      "cache": false,
      "persistent": true
    },
    "//#listen:stripe": {
      "dependsOn": ["//#compile:transit"],
      "env": ["AWS_*", "DOTENV_*", "FLEX_*", "GIT_*", "NEXT_PUBLIC_*"],
      "cache": false,
      "persistent": true
    },
    "//#compile:tsc:project:references": {
      "dependsOn": [
        "@flexiness/domain-utils#compile:tsup",
        "@flexiness/copilotkit#compile:tsup",
        "@flexiness/typed-scss-modules#compile:proj:ref:cjs:phase1",
        "@flex-design-system/framework#build:types:scss"
      ],
      "outputs": [
        "packages/flex/design-system-react-ts/dist/**",
        "packages/flex/domain-store/dist/**",
        "packages/flex/config/eslint/flat-config/dist/**",
        "packages/flex/design-system-framework/types/__generated__/default/**"
      ],
      "cache": true,
      "persistent": false
    },
    "//#compile:transit": {
      "dependsOn": ["//#compile:tsc:project:references", "gateway#next:tsc"],
      "cache": true,
      "persistent": false
    },
    "//#compile:watch:sh": {
      "outputs": [
        "packages/flex/domain-store/dist/**",
        "apps/gateway/public/slides/**"
      ],
      "cache": false,
      "persistent": true
    },
    "seed": {
      "dependsOn": ["gateway#amplify:sandbox:create"],
      "env": ["AWS_*", "DOTENV_*", "FLEX_*"],
      "cache": true,
      "persistent": false
    },
    "lint": {
      "dependsOn": ["//#compile:transit", "^lint"],
      "env": ["FLEX_*", "GIT_*"],
      "cache": true,
      "persistent": false
    },
    "build:lib": {
      "dependsOn": ["//#compile:transit", "^build:lib"],
      "env": ["FLEX_*", "GIT_*"],
      "cache": true,
      "persistent": false
    },
    "build": {
      "dependsOn": ["//#compile:transit", "^build:lib", "^build"],
      "env": [
        "AWS_*",
        "DOTENV_*",
        "FLEX_*",
        "GIT_*",
        "NEXT_PUBLIC_*",
        "SENTRY_*"
      ],
      "cache": true,
      "persistent": false
    },
    "dev": {
      "dependsOn": ["//#compile:transit"],
      "env": ["AWS_*", "DOTENV_*", "FLEX_*", "GIT_*", "NEXT_PUBLIC_*"],
      "cache": false,
      "persistent": true
    }
  }
}

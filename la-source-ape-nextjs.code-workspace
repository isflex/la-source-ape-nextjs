{
  "folders": [
    {
      "name": "✨ monorepo",
      "path": ".",
    },
    {
      "name": "🌍 gateway",
      "path": "apps/gateway/src",
    },
    {
      "name": "⚛️ design-components",
      "path": "packages/flex/design-system-react-ts/src",
    },
    {
      "name": "🌈 design-framework",
      "path": "packages/flex/design-system-framework/src/modules3",
    },
    {
      "name": "🪲 traces",
      "path": "/home/ischerer/workspaces/flex/la-source-ape/gateway/flexi/tmp",
    },
  ],
  "settings": {
    // ========================================
    // EDITOR SETTINGS
    // ========================================
    "workbench.colorTheme": "Default Dark+",
    "editor.tabSize": 2,
    "editor.wordWrapColumn": 150,
    "editor.rulers": [150],
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
    },

    // ========================================
    // FILE SETTINGS
    // ========================================
    "files.eol": "\n",
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
      "amplify/.config": true,
      "amplify/**/*-parameters.json": true,
      "amplify/**/amplify.state": true,
      "amplify/**/transform.conf.json": true,
      "amplify/#current-cloud-backend": true,
      "amplify/backend/amplify-meta.json": true,
      "amplify/backend/awscloudformation": false,
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/.hg/store/**": true,
      "**/build/*/**": true,
      "**/dist/*/**": true,
    },

    // ========================================
    // SEARCH SETTINGS
    // ========================================
    "search.exclude": {
      "**/build/**": true,
      "**/dist/**": true,
      "**/node_modules": true,
      "**/.yarn": true,
      "**/.pnp.*": true,
      "**/pnpm-lock.yaml": true,
    },

    // ========================================
    // TYPESCRIPT SETTINGS
    // ========================================
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.preferences.quoteStyle": "single",
    "typescript.preferences.importModuleSpecifier": "relative",
    "typescript.updateImportsOnFileMove.enabled": "always",

    // ========================================
    // ESLINT SETTINGS
    // ========================================
    "eslint.enable": true,
    "eslint.format.enable": true,
    "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
    "eslint.options": {
      "overrideConfigFile": "${workspaceFolder}/eslint.config.mjs",
    },
    "eslint.workingDirectories": [
      { "pattern": "./apps/**/src/*", "!cwd": true },
      { "pattern": "./packages/**/src/*", "!cwd": true },
    ],
    "eslint.ignoreUntitled": true,
    "eslint.lintTask.enable": true,
    "eslint.codeActionsOnSave.mode": "problems",

    // ========================================
    // LANGUAGE-SPECIFIC SETTINGS
    // ========================================
    "[javascript]": {
      "editor.tabSize": 2,
      "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    },
    "[javascriptreact]": {
      "editor.tabSize": 2,
      "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    },
    "[typescript]": {
      "editor.tabSize": 2,
      "editor.defaultFormatter": "dbaeumer.vscode-eslint",
      "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
      },
    },
    "[typescriptreact]": {
      "editor.tabSize": 2,
      "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    },
    "[json]": {
      "editor.tabSize": 2,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": ["source.sortPackageJson"],
    },
    "[jsonc]": {
      "editor.tabSize": 2,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[html]": {
      "editor.tabSize": 2,
    },
    "[markdown]": {
      "editor.wordWrap": "on",
    },

    // ========================================
    // CSS/SCSS SETTINGS
    // ========================================
    "css.validate": false,
    "less.validate": false,
    "scss.validate": false,
    "stylelint.snippet": ["css", "scss", "less", "postcss"],
    "stylelint.validate": ["css", "scss", "less", "postcss"],
    "stylelint.configFile": "${workspaceFolder}/packages/flex/design-system-framework/.scss.stylelintrc.json",

    // ========================================
    // HTML/PRETTIER SETTINGS
    // ========================================
    "html.format.wrapLineLength": 150,
    "prettier.printWidth": 150,
    "htmltagwrap.tag": "div",
    "htmltagwrap.autoDeselectClosingTag": true,

    // ========================================
    // JSON SCHEMA
    // ========================================
    "json.schemaDownload.enable": true,

    // ========================================
    // TERMINAL SETTINGS (WSL)
    // ========================================
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.env.linux": {
      "FLEX_PROJ_ROOT": "${workspaceFolder}",
      "FLEX_MODE": "development",
    },
    "terminal.integrated.env.windows": {
      // "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Program Files\\Git\\bin\\bash.exe",
      "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Users\\inoe\\Git\\bin\\bash.exe",
    },

    // ========================================
    // TAILWIND CSS
    // ========================================
    "tailwindCSS.experimental.classRegex": [
      ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
      ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ],
    "tailwindCSS.includeLanguages": {
      "typescript": "javascript",
      "typescriptreact": "javascript",
    },

    // ========================================
    // CLAUDE AI INTEGRATION
    // ========================================
    "claude.projectPath": "${workspaceFolder}",
    "claude.enableMcp": true,
  },

  // ========================================
  // EXTENSIONS
  // ========================================
  "extensions": {
    "recommendations": [
      "anthropic.claude-code",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss",
      "ms-vscode.vscode-typescript-next",
      "ms-azuretools.vscode-docker",
      "amazonwebservices.aws-toolkit-vscode",
      "hashicorp.hcl",
      "mrmlnc.vscode-duplicate",
      "meganrogge.template-string-converter",
      "jinsihou.diff-tool",
      "bradgashler.htmltagwrap",
      "firsttris.vscode-jest-runner",
      "unional.vscode-sort-package-json",
      "stylelint.vscode-stylelint",
      "mikestead.dotenv",
      "github.vscode-pull-request-github",
      "eamodio.gitlens",
    ],
    "unwantedRecommendations": [],
  },

  // ========================================
  // LAUNCH CONFIGURATIONS
  // ========================================
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js: debug server-side",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm dev",
        "cwd": "${workspaceFolder}",
        "env": {
          "NODE_OPTIONS": "--inspect",
          "FLEX_PROJ_ROOT": "${workspaceFolder}",
          "FLEX_MODE": "development",
        },
      },
      {
        "name": "Next.js: debug client-side",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3001",
        "webRoot": "${workspaceFolder}/apps/gateway",
        "sourceMaps": true,
      },
      {
        "name": "Debug Current TS File",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "node",
        "runtimeArgs": ["--loader", "ts-node/esm", "--no-warnings"],
        "args": ["${file}"],
        "cwd": "${workspaceFolder}",
        "env": {
          "FLEX_PROJ_ROOT": "${workspaceFolder}",
          "FLEX_MODE": "development",
        },
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"],
      },
      {
        "name": "Attach to Node Process",
        "type": "node",
        "request": "attach",
        "port": 9229,
        "skipFiles": ["<node_internals>/**"],
      },
    ],
    "compounds": [
      {
        "name": "Next.js: debug full stack",
        "configurations": ["Next.js: debug server-side", "Next.js: debug client-side"],
      },
    ],
  },

  // ========================================
  // TASKS
  // ========================================
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Compile",
        "type": "shell",
        "command": "pnpm compile",
        "group": "build",
        "problemMatcher": ["$tsc"],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
        },
        "options": {
          "env": {
            "FLEX_PROJ_ROOT": "${workspaceFolder}",
            "FLEX_MODE": "development",
          },
        },
      },
      {
        "label": "Compile (Watch)",
        "type": "shell",
        "command": "pnpm compile:watch",
        "group": "build",
        "isBackground": true,
        "problemMatcher": ["$tsc-watch"],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
        },
        "options": {
          "env": {
            "FLEX_PROJ_ROOT": "${workspaceFolder}",
            "FLEX_MODE": "development",
          },
        },
      },
      {
        "label": "Dev Server",
        "type": "shell",
        "command": "pnpm dev",
        "group": {
          "kind": "build",
          "isDefault": true,
        },
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
        },
        "options": {
          "env": {
            "FLEX_PROJ_ROOT": "${workspaceFolder}",
            "FLEX_MODE": "development",
          },
        },
      },
      {
        "label": "Lint",
        "type": "shell",
        "command": "pnpm lint",
        "group": "test",
        "problemMatcher": ["$eslint-stylish"],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
        },
      },
      {
        "label": "Build",
        "type": "shell",
        "command": "pnpm build",
        "group": "build",
        "problemMatcher": ["$tsc"],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
        },
        "options": {
          "env": {
            "FLEX_PROJ_ROOT": "${workspaceFolder}",
            "FLEX_MODE": "development",
          },
        },
      },
      {
        "label": "Claude AI",
        "type": "shell",
        "command": "pnpm ai:claude",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true,
        },
        "options": {
          "env": {
            "FLEX_PROJ_ROOT": "${workspaceFolder}",
            "FLEX_MODE": "development",
          },
        },
      },
      {
        "label": "Install Dependencies",
        "type": "shell",
        "command": "pnpm install",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
        },
      },
      {
        "label": "Compile + Dev",
        "dependsOrder": "sequence",
        "dependsOn": ["Compile", "Dev Server"],
        "group": "build",
        "presentation": {
          "reveal": "always",
        },
      },
      {
        "label": "Amplify Sandbox",
        "type": "shell",
        "command": "pnpm ampx sandbox --once",
        "options": {
          "cwd": "${workspaceFolder}/apps/gateway",
        },
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
        },
      },
    ],
  },
}

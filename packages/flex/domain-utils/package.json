{
  "name": "@flexiness/domain-utils",
  "version": "0.0.1",
  "private": true,
  "description": "Utilities module for micro frontend development",
  "keywords": [],
  "license": "MIT",
  "author": "Flexiness <hello@flexiness.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style-loader-esm": "./dist/esm/utils/style-loader.js",
    "./style-loader-cjs": "./dist/cjs/utils/style-loader.js",
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean:compile": "pnpm exec rimraf '{dist,*.tsbuildinfo}'",
    "clean:compile:buildinfo": "pnpm exec rimraf '{*.tsbuildinfo}'",
    "clean:lib": "pnpm clean:source && pnpm clean:compile",
    "clean:source": "pnpm exec rimraf '{src/**/*.d.ts,src/**/*.js,src/**/*.js.map}'",
    "compile:tsup": "tsup",
    "lint": "pnpm lint:flat",
    "lint:flat": "cross-env NODE_OPTIONS='--max-old-space-size=8192' ESLINT_USE_FLAT_CONFIG=true pnpm eslint \"./src/**/*.{ts,tsx}\" --fix",
    "tsc": "tsc"
  },
  "dependencies": {
    "@aws-crypto/sha256-browser": "5.2.0",
    "@aws-crypto/sha256-js": "5.2.0",
    "cors": "2.8.5",
    "crypto-browserify": "3.12.0",
    "express": "5.1.0",
    "helmet-csp": "3.4.0",
    "loglevel": "1.8.0",
    "psl": "1.9.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tslib": "^2.8.1",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@flexiness/eslint-config-flat": "@flexiness/eslint-config-flat@1.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.1",
    "@types/psl": "1.1.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "9.0.3",
    "csstype": "3.1.3",
    "flexiness": "workspace:../types",
    "rimraf": "6.1.0",
    "ts-node": "10.9.2",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}

{
  "name": "@flexiness/domain-tailwind",
  "version": "0.0.1",
  "private": true,
  "description": "Tailwind module for micro frontend development",
  "keywords": [],
  "license": "MIT",
  "author": "Flexiness <hello@flexiness.com>",
  "exports": {
    ".": {
      "@flexiness/source": "./src/js/tailwind.tsx",
      "import": "./dist/js/tailwind.js",
      "require": "./dist/js/tailwind.js",
      "types": "./dist/js/tailwind.d.ts"
    },
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./postcss.config.mjs": "./postcss.config.mjs"
  },
  "browser": {
    "./tailwind.css": "./dist/styles/tailwind.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:lib": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- pnpm build:tailwind:css:gateway",
    "build:tailwind:css": "pnpm dlx @tailwindcss/cli -i ./src/styles/globals.css -o ./dist/styles/tailwind.css",
    "build:tailwind:css:gateway": "pnpm dlx @tailwindcss/cli -i ./src/styles/globals.css -o $FLEX_PROJ_ROOT/apps/gateway/src/styles/tailwind.css",
    "build:tsc": "tsc -p ./tsconfig.build.json",
    "clean:built": "pnpm exec rimraf '{lib,module,dist,*.tsbuildinfo}'",
    "clean:lib": "pnpm clean:source && pnpm clean:built",
    "clean:source": "pnpm exec rimraf '{src/**/*.d.ts,src/**/*.js,src/**/*.js.map}'",
    "clean:tsc:buildinfo": "pnpm exec rimraf '{*.tsbuildinfo}'",
    "dev:tailwind": "dotenvx run -f $FLEX_PROJ_ROOT/env/public/.env.$FLEX_MODE -- pnpm dev:tailwind:css:gateway:watch",
    "dev:tailwind:css:gateway:watch": "pnpm dlx @tailwindcss/cli --watch -i ./src/styles/globals.css -o $FLEX_PROJ_ROOT/apps/gateway/src/styles/tailwind.css",
    "dev:tailwind:css:watch": "pnpm dlx @tailwindcss/cli --watch -i ./src/styles/globals.css -o ./dist/styles/tailwind.css",
    "lint": "pnpm lint:flat",
    "lint:flat": "cross-env NODE_OPTIONS='--max-old-space-size=8192' ESLINT_USE_FLAT_CONFIG=true pnpm eslint \"./src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.44.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@flexiness/eslint-config-flat": "workspace:*",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "flexiness": "workspace:*",
    "ncp": "^2.0.0",
    "postcss": "^8.5.0",
    "postcss-cli": "10.1.0",
    "postcss-loader": "8.1.1",
    "postcss-syntax": "0.36.2",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rimraf": "6.1.0",
    "typescript": "5.9.3"
  }
}
